# ParaBank test credentials - copy to .env and fill in values
# Never commit .env to git (it is in .gitignore)

# Default user (required for tests)
PARABANK_USERNAME_DEFAULT=your_username
PARABANK_PASSWORD_DEFAULT=your_password

# Optional: admin and guest users
# PARABANK_USERNAME_ADMIN=admin_user
# PARABANK_PASSWORD_ADMIN=admin_pass
# PARABANK_USERNAME_GUEST=guest_user
# PARABANK_PASSWORD_GUEST=guest_pass
